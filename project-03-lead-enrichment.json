        "jsCode": "const response = $input.first().json;\n// Ollama Chat Model output structure: response.message.content\nconst content = response.message?.content || response.response || \"\";\nlet parsed = {};\ntry {\n    parsed = JSON.parse(content);\n} catch (e) {\n    parsed = {};\n}\nconst webhookData = $('Webhook').first().json;\nconst originalMessage = webhookData.body?.message || webhookData.message || \"\";\n\nreturn {\n    json: {\n        ...parsed,\n        raw_message: originalMessage,\n        notes: parsed.notes || \"\"\n    }\n};"
